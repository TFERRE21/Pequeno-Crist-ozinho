# Stripe (use chaves de teste para validar antes de produção)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=brl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL existente
DATABASE_URL=postgresql://usuario:senha@localhost:5432/pequeno_cristaozinho
# Alternativas aceitas pelo helper de banco: POSTGRES_URL ou POSTGRESQL_URI
PG_POOL_MAX=10
PGSSLMODE=

# Gere um segredo aleatório com pelo menos 32 caracteres
AUTH_SECRET=replace_with_at_least_32_random_characters
AUTH_RATE_LIMIT_SALT=replace_with_random_salt

# E-mail transacional Resend
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=
DELIVERY_TOKEN_SECRET=replace_with_another_long_random_secret

# IA de suporte (opcional; sem chave, o sistema registra a mensagem e informa que IA não está configurada)
OPENAI_API_KEY=
SUPPORT_AI_MODEL=gpt-4.1-mini

# Proteção do endpoint de fabricação de arquivos
ADMIN_API_TOKEN=
